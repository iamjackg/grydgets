# Configuration for grydgets-client, the remote display.
#
# This machine renders nothing. It connects to a Grydgets instance with a
# `stream` output and fetches each new frame at this screen's resolution. No
# widgets.yaml, no providers.yaml, no fonts.

server:
  # The rendering machine's HTTP server. That instance needs a `stream` output
  # and a server.host this machine can reach -- 127.0.0.1 will not work.
  url: http://dashboard-host:5000
  # Only needed if the server sets server.auth.stream_token. Must match it.
  # token: !secret stream_token
  # Seconds to wait before reconnecting after a dropped connection. A rejected
  # token backs off for five minutes regardless of this setting.
  reconnect_delay: 2
  # Seconds the connection must stay down before the warning triangle -- or
  # the offline screen below -- appears over the last frame.
  stale_after: 30

graphics:
  # This screen's resolution. Sent to the server, which encodes frames at this
  # size so this machine never has to scale one. A frame that arrives at some
  # other size is scaled to fit here instead.
  resolution: [1366, 768]

logging:
  # debug also draws a latency panel (notice/download/display/total) in the
  # top-left corner of every frame, so you can see how long the pipeline is
  # taking without leaving the screen.
  level: info

# Where the warning triangle sits: top-left, top-right, bottom-left or
# bottom-right. Move it if it covers something you need to read.
indicator:
  corner: bottom-right

# What to show when the server has been unreachable for stale_after seconds.
# Off by default, which leaves just the warning triangle over the last frame.
# Enabled, the last frame is dimmed instead and a large clock and a message
# take its place, so the screen stays useful as a clock. It also works before
# the first frame ever arrives, on a viewer that booted while the server was
# down.
offline:
  enabled: false
  message: Dashboard server unavailable
  # strftime format. Add %S if you want a ticking seconds display.
  clock_format: "%H:%M"
  # How far to darken the last frame: 0 leaves it alone, 1 blacks it out.
  dim: 0.75

# One display output: window or framebuffer.
outputs:
  - type: window
    fullscreen: true
    # x_display: ':0'  # Only needed when starting via SSH

  # - type: framebuffer
  #   device: /dev/fb1
